POSTGRES_DB=kioskitos
POSTGRES_USER=kioskitos
POSTGRES_PASSWORD=kioskitos_dev_password
POSTGRES_PORT=5432
BACKEND_PORT=8080
FRONTEND_PORT=3000
ASPNETCORE_ENVIRONMENT=Development
NEXT_PUBLIC_API_URL=http://localhost:8080

# Connection string used from the host (dotnet ef, tests). 
# Inside compose the backend uses host "postgres".
ConnectionStrings__Default="Host=localhost;Port=5432;Database=kioskitos;Username=kioskitos;Password=kioskitos_dev_password"

Google__ClientId=
Google__ClientSecret=
NEXT_PUBLIC_GOOGLE_CLIENT_ID=

Jwt__Key=
Jwt__Issuer=kioskitos-api
Jwt__Audience=kioskitos-frontend